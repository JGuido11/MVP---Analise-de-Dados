      "cell_type": "markdown",
      "source": [
        "### 3.3.6 Nuvem de Palavras\n",
        "\n",
        "Aqui busco entender quais são as palavras que mais dominam os títulos do catálogo da Netflix."
      ],
      "metadata": {
        "id": "YcFVd6_O6eem"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# --- PROCESSAMENTO DO TEXTO ---\n",
        "# Concatenei todos os títulos em uma única string\n",
        "text = \" \".join(df_netflix['title'].dropna().astype(str).tolist())\n",
        "\n",
        "# Limpeza opcional (embora a WordCloud cuide disso):\n",
        "# text = text.replace(',', '').replace('[', '').replace(\"'\", '').replace(']', '').replace('.', '')\n",
        "\n",
        "# --- PREPARAÇÃO DA MÁSCARA ---\n",
        "# Carregar a imagem fornecida como máscara\n",
        "try:\n",
        "    # Abre a imagem fornecida\n",
        "    mask_image = Image.open('https://github.com/JGuido11/MVP---Analise-de-Dados/blob/main/netflix_mask.jpg')\n",
        "\n",
        "    # É crucial converter para escala de cinza e depois um array numpy\n",
        "    # para que a WordCloud interprete as áreas brancas como transparentes\n",
        "    mask = np.array(mask_image.convert('L'))\n",
        "except FileNotFoundError:\n",
        "    print(\"Aviso: Arquivo de máscara 'netflix_mask.jpg' não encontrado. Gerando nuvem retangular padrão.\")\n",
        "    mask = None\n",
        "\n",
        "# --- DEFINIÇÃO DO MAPA DE CORES E STOPWORDS ---\n",
        "# Mapa de cores personalizado (Paleta Netflix)\n",
        "cmap = matplotlib.colors.LinearSegmentedColormap.from_list(\"\", [COLORS['Dark_Grey'], COLORS['Netflix_Red_']])\n",
        "\n",
        "# Adicionei algumas stopwords (palavras a ignorar) extras se necessário\n",
        "custom_stopwords = set(STOPWORDS)\n",
        "# Exemplo: custom_stopwords.update([\"The\", \"A\", \"Of\", \"And\"]) # se houver mistura de idiomas\n",
        "\n",
        "# --- GERAÇÃO DA WORDCLOUD (Motor) ---\n",
        "# Criei o objeto WordCloud com a máscara do 'N'\n",
        "wc = WordCloud(\n",
        "    background_color='white', mask=mask,\n",
        "    colormap=cmap, max_words=50,\n",
        "    width=1000, height=1000,\n",
        "    stopwords=custom_stopwords,\n",
        "    mode='RGB' # Garante que as cores funcionem bem com a conversão posterior\n",
        ").generate(text)\n",
        "\n",
        "# --- INTEGRAÇÃO COM PLOTLY ---\n",
        "# O Plotly não renderiza a WordCloud diretamente, então converti em uma imagem\n",
        "# para ser usada como o trace do gráfico.\n",
        "\n",
        "fig12 = go.Figure()\n",
        "\n",
        "# Adicionei a imagem gerada pela WordCloud como um trace do tipo go.Image\n",
        "# wc.to_array() converte a nuvem de palavras em um array numpy de pixels\n",
        "fig12.add_trace(go.Image(z=wc.to_array()))\n",
        "\n",
        "# --- AJUSTES DE LAYOUT ---\n",
        "# Configurei o título e limpei os eixos para o visual de dashboard\n",
        "fig12.update_layout(\n",
        "    title=dict(\n",
        "        text=\"<b>Palavras mais Comuns nos Títulos do Catálogo</b><br><sup>Nuvem de termos em formato do 'N' da Netflix</sup>\",\n",
        "        x=0.05,\n",
        "        font=dict(family=\"serif\", size=22, color=COLORS['Dark_Grey'])\n",
        "    ),\n",
        "    # Removi os eixos para parecer uma imagem limpa e não um gráfico matemático\n",
        "    xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),\n",
        "    yaxis=dict(showgrid=False, zeroline=False, showticklabels=False),\n",
        "    plot_bgcolor='white',\n",
        "    paper_bgcolor='white',\n",
        "    margin=dict(t=100, b=20, l=50, r=50),\n",
        "    height=600, # Altura boa para dashboard\n",
        "    width=600 # Largura quadrada para caber bem o 'N'\n",
        ")\n",
        "\n",
        "# Exibir o gráfico interativo do Plotly\n",
        "fig12.show()"
      ],
